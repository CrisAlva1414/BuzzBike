<?xml version="1.0" encoding="utf-8"?>
<!--
    BuzzBike — AndroidManifest

    Solo se declaran los permisos que la app usa hoy. Los permisos de
    features futuras (background location, activity recognition, BLE,
    health FGS, sensores de alta frecuencia) se agregan recién cuando la
    feature exista, para no ampliar la superficie de permisos sin código
    que los justifique.

    PRIVACY (AGENTS.md §7): local-first, nada sale del dispositivo sin
    acción explícita del usuario. No hay analytics, ni cuentas, ni
    crash-reporting de terceros en este manifiesto.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Location — trackeo de rides.
        FINE + COARSE: GPS del teléfono. El trackeo continuo se hace con
        un foreground service type=location; ACCESS_BACKGROUND_LOCATION se
        agregará recién si se implementa trackeo con la app realmente en
        background.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        Notifications — notificación del foreground service + alertas de
        desgaste de componentes (ADR-004). API 33+ requiere runtime grant;
        en APIs anteriores se concede con la instalación.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Foreground service — Android 14+ (API 34) exige un type explícito
        por permiso. FOREGROUND_SERVICE_LOCATION: tracking GPS continuo.
        FOREGROUND_SERVICE_HEALTH se agregará si aparece una feature que
        realmente use el type=health.
        En API < 34 estos permisos no existen; declararlos es inofensivo.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
        Sync opcional a Hermes Agent (ADR-003) vía webhook sobre Tailscale.
        INTERNET + ACCESS_NETWORK_STATE: comprobar conectividad antes del
        sync diferido (WorkManager constraints). Nada se envía sin opt-in
        del usuario.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        HARDWARE — la app es inútil sin GPS y no tiene sentido en tablets
        sin sensores de ubicación. bluetooth.le queda opcional para el
        futuro HR strap / CSC, pero sin permisos BLE hasta implementarlo.
    -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:name=".BuzzBikeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BuzzBike"
        tools:targetApi="34">

        <!--
            MainActivity — exported=true porque es la launcher activity
            (intenta-filter MAIN/LAUNCHER). Sin deeplinks externos en v1.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BuzzBike"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <service
            android:name=".service.TrackingService"
            android:foregroundServiceType="location"
            android:exported="false" />
    </application>
</manifest>
