# ktlint — official Kotlin style (docs/format/estilo-kotlin.md, AGENTS.md §8).
# Referencia: https://pinterest.github.io/ktlint/latest/rules/configuration/

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

[*.{kt,kts}]
# Official Kotlin formatting (not android_studio, not intellij_idea).
ktlint_code_style = ktlint_official

# Allow wildcard imports for Compose and Hilt — both ecosystems use them
# heavily; forcing FQNs hurts readability more than it helps.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Package naming: lowercase, no underscores (docs/format/estilo-kotlin.md §1).
ktlint_standard_package-name = enabled

# @Composable functions are PascalCase by Compose convention
# (docs/format/estilo-kotlin.md §1: `RideScreen`, `WearAlertCard`).
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,json,yml,yaml,md,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
